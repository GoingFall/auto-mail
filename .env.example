# auto-mail 配置模板
# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
# 所有项均有默认值，只有取值为空白的项才需要你填写。

# ══════════════════════════════════════════════════════════════
# 1. 163 邮箱（IMAP 只读）
# ══════════════════════════════════════════════════════════════
# 网页版：设置 → POP3/SMTP/IMAP → 开启 IMAP/SMTP → 新增授权密码
# 注意：填 16 位「客户端授权码」，不是网页登录密码。授权码只显示一次。
# ACCOUNT 是账号标签，数据库所有唯一约束都含该维度（为多邮箱预留）。
ACCOUNT=163
IMAP_HOST=imap.163.com
IMAP_PORT=993
# 163 使用隐式 SSL。仅本地明文代理或测试场景才改为 false。
IMAP_USE_SSL=true
IMAP_USER=
IMAP_AUTH_CODE=

# 同步的文件夹，逗号分隔。INBOX 必填。
IMAP_FOLDERS=INBOX

# 你自己的全部邮箱地址（主地址 + 别名 + 发件地址），逗号分隔。
# 用于判断邮件方向（收信/发信）——影响线程重建与「等你回复」的判断。
# 留空时回退到 IMAP_USER；宁可判成收信，也不会凭空声称你发过信。
USER_ADDRESSES=

# 163/Coremail 声明 SASL-IR 能力却拒绝 inline 形式，必须保持 false。
IMAP_USE_SASL_IR=false

# IMAP ID 命令(RFC 2971)参数：163 在 SELECT 前强制要求发 ID，否则 Unsafe Login。
IMAP_CLIENT_ID_NAME=auto-mail
IMAP_CLIENT_ID_VERSION=0.1.0
IMAP_CLIENT_ID_VENDOR=auto-mail
IMAP_CLIENT_ID_SUPPORT_EMAIL=

IMAP_SOCKET_TIMEOUT=60

# 单次 FETCH 的邮件数上限。实测一次性取大量邮件更容易被服务端断连。
IMAP_FETCH_BATCH_SIZE=10

# 会话失效（163 的空闲超时约 2~4 分钟、另一客户端登录、限流）后的重连重试。
# 这是预期事件而非故障：实测不重连时「89 封里 69 封失败」，加上重连后零失败。
IMAP_RECONNECT_ATTEMPTS=3
IMAP_RECONNECT_BACKOFF_SECONDS=3.0

# 轮询间隔（163 不支持 IDLE，只能轮询）。不要低于 15 分钟，否则触发风控。
POLL_INTERVAL_MINUTES=15

# ══════════════════════════════════════════════════════════════
# 2. Google Calendar
# ══════════════════════════════════════════════════════════════
# Google Cloud：建项目 → 启用 Calendar API → OAuth 同意屏 → 桌面应用客户端
# 下载 JSON 存为 credentials.json。首次 automail auth 会生成 token.json。
# 注意：Testing 状态下敏感 scope 的 refresh token 可能约 7 天失效；
#       程序会处理失效并提示重新授权，不单靠发布状态解决。
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# 代理（Google 不可直连时填写；NO_PROXY 用于让邮件流量绕开代理）
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=imap.163.com,imap.126.com,localhost,127.0.0.1

# ══════════════════════════════════════════════════════════════
# 3. LLM 抽取（OpenAI 兼容；境内服务优先，邮件内容不出境）
# ══════════════════════════════════════════════════════════════
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_CALLS_PER_RUN=50

# 发送给 LLM 的字段白名单（逗号分隔）。
# 可选：excerpt, subject, received_at, timezone, sender_name
# 注意 sender_name 常含真名，默认不发。
LLM_PAYLOAD_FIELDS=excerpt,subject,received_at,timezone

# 送 LLM 前的二次截断（中文约 1 字 ≈ 1 token）
LLM_EXCERPT_MAX_CHARS=1500
LLM_MAX_INPUT_TOKENS=2000

# ══════════════════════════════════════════════════════════════
# 4. 抽取与入历策略
# ══════════════════════════════════════════════════════════════
EXCERPT_MAX_CHARS=4000

# 逐邮件 LLM 尝试上限，超限转 extract_status=failed（防止毒邮件每轮烧钱）
EXTRACT_MAX_ATTEMPTS=3

# 自动入历门槛，严格大于（0.85 仅「绝对日期+显式时刻」0.95 档可过）
CONFIDENCE_AUTO_PUSH_THRESHOLD=0.85

# 每轮自动推送上限；超出的保持 approved 顺延到下一轮
AUTO_PUSH_LIMIT_PER_RUN=10

# 自动入历的可撤销延迟窗口（分钟）。人工 approve 不走此窗口。
# 实际窗口 = 本值 ~ 本值+轮询间隔，因为调度按轮询粒度执行。
AUTO_PUSH_DELAY_MINUTES=5

# 非联系人（从未往来）发来的 ICS 是否自动入历。默认 false → 进待审。
ICS_AUTO_PUSH_NON_CONTACT=false

PUSH_MAX_ATTEMPTS=5

# 日历事件在 Google 侧消失时的策略：pending | recreate | fail
NOT_FOUND_POLICY=pending

# 同一文本内多个候选日期的取舍：pending | earliest
# 注意：无年份日期是硬门，恒 pending，不受本项影响。
AMBIGUOUS_DATE_POLICY=pending

LOW_CONFIDENCE_EVENT_POLICY=pending

DEFAULT_EVENT_DURATION_MINUTES=30
DEFAULT_REMINDER_TIME=09:00

# ══════════════════════════════════════════════════════════════
# 4b. 已读回写（本项目唯一的邮箱写操作，默认关闭）
# ══════════════════════════════════════════════════════════════
#
# 作用：把「已处理完」的邮件在邮箱里标为已读，让「未读」继续表示
#       「需要你处理」——而不是被已处理的邮件占满。
#
# 这是本程序唯一会改变邮箱状态的操作（此前全程只读：EXAMINE + BODY.PEEK），
# 因此**默认关闭**，且命令默认 dry-run。只改 \Seen 一个标志，
# 不删邮件、不移动、不改别的标志；标错了可用 `automail mark-read --undo` 回退。
#
#   off        不开启（默认）
#   resolved   只在「没有任何事件等你处理」时标记（推荐）
#   processed  所有抽取完成的邮件都标记
#
# resolved 的判定：pending / uncertain / push_failed 这几种状态的事件
# 意味着还等着你（或等着程序重试），此时**保持未读**。
MARK_READ_POLICY=off

# 只回写这些文件夹（逗号分隔）。留空则跟随 IMAP_FOLDERS。
# 通常只需整理 INBOX：把已发送/垃圾箱标为已读没有意义。
MARK_READ_FOLDERS=

# 单次 STORE 的 UID 数上限（避免一次命令过大触发风控）。
MARK_READ_BATCH_SIZE=50

# ══════════════════════════════════════════════════════════════
# 5. 同步一致性与存储
# ══════════════════════════════════════════════════════════════
# 每 N 次增量同步后做一次补偿扫描
COMPENSATE_SCANS=20
# 补偿扫描回看的最近天数
COMPENSATE_DAYS=14

DB_BACKUP_KEEP=3
DB_BACKUP_MAX_AGE_DAYS=14

# ══════════════════════════════════════════════════════════════
# 6. 通用
# ══════════════════════════════════════════════════════════════
USER_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

DATA_DIR=data
OUT_DIR=out
LOG_DIR=logs

# v2 功能（需回复追踪）的阈值
REPLY_THRESHOLD_HOURS=24
